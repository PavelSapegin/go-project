{
    "swagger": "2.0",
    "info": {
        "description": "This is a sample server for a movie API.",
        "title": "Movie API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/last-movie": {
            "get": {
                "description": "Fetches the last movie from the external service.",
                "summary": "Get the last movie",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/client.Response"
                        }
                    },
                    "500": {
                        "description": "Error fetching last movie",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/load-movies": {
            "get": {
                "description": "Fetches movies from the external service based on the provided 'from' and 'to' query parameters.",
                "summary": "Get movies from a specified range",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Starting movie ID",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Ending movie ID",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/client.Response"
                            }
                        }
                    },
                    "400": {
                        "description": "Missing or invalid 'from' or 'to' parameter",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Error fetching movies",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "client.Response": {
            "type": "object",
            "properties": {
                "director": {
                    "type": "string"
                },
                "movie_id": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "year": {
                    "type": "integer"
                }
            }
        }
    }
}