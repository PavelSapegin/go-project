{
    "swagger": "2.0",
    "info": {
        "description": "This is a sample server for a movie API.",
        "title": "Movie API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/last-movie": {
            "get": {
                "description": "Fetches the last movie from the external service.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get the last movie",
                "responses": {
                    "200": {
                        "description": "Last movie details",
                        "schema": {
                            "$ref": "#/definitions/client.Response"
                        }
                    },
                    "404": {
                        "description": "No movies found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "External service error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "504": {
                        "description": "Request to external service timed out",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/load-movies": {
            "get": {
                "description": "Fetches movies from the external service based on the provided 'from' and 'to' query parameters.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get movies from a specified range",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Starting movie ID",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Ending movie ID",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of fetched movies along with any partial errors",
                        "schema": {
                            "$ref": "#/definitions/handler.LoadMoviesResponse"
                        }
                    },
                    "400": {
                        "description": "Missing or invalid 'from' or 'to' parameter",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "504": {
                        "description": "Request to external service timed out",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "client.Response": {
            "type": "object",
            "properties": {
                "director": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "year": {
                    "type": "integer"
                }
            }
        },
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "handler.LoadMoviesResponse": {
            "type": "object",
            "properties": {
                "errors": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "movies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/client.Response"
                    }
                }
            }
        }
    }
}